import pandas as pd
import numpy as pd
data = pd.Series(
    np.random.randn(6),
    index=[['a', 'a', 'b', 'b', 'c', 'c'],
           [1, 2, 1, 2, 1, 2]]
)

print('Original Series:')
print(data)

print('\nValues for index b:')
print(data['b'])

print('\nValues with second index = 1:')
print(data[:, 1])
